# Copy to .env (gitignored) and fill in. docker compose reads it for variable substitution.
# This is separate from backend/.env, which is for running the backend directly on your machine.

POSTGRES_PASSWORD=
AUTH_SECRET_KEY=

# Cloudflare R2 (only needed for the endpoints that store/read user images)
R2_USER_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
